{
  "name": "gfghub",
  "version": "2.1.0",
  "private": true,
  "description": "Automatically sync accepted GeeksforGeeks solutions to GitHub",
  "type": "module",
  "scripts": {
    "dev": "webpack --mode=production --watch",
    "setup": "npm i",
    "format": "prettier --write \"scripts/**/*.js\" \"spec/**/*.js\" \"css/**/*.css\" \"*.html\" \"*.js\" \"manifest-*.json\" package.json README.md",
    "format-test": "prettier --check \"scripts/**/*.js\" \"spec/**/*.js\" \"css/**/*.css\" \"*.html\" \"*.js\" \"manifest-*.json\" package.json README.md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "webpack --mode=production",
    "test": "jasmine"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "chrome-types": "^0.1.282",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.39.5",
    "filemanager-webpack-plugin": "^8.0.0",
    "ignore-loader": "^0.1.2",
    "jasmine": "^5.1.0",
    "prettier": "^2.2.1",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  }
}
